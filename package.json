{
  "name": "lookout-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @lookout/app dev",
    "build": "pnpm --filter @lookout/app build",
    "preview": "pnpm --filter @lookout/app preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "oracle": "pnpm --filter @lookout/oracle start",
    "lint": "oxlint --deny-warnings apps oracle",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm --filter @lookout/oracle check:shared"
  },
  "devDependencies": {
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@10.33.4"
}
