{
  "name": "@lookout/app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "typecheck": "tsr generate && tsc --noEmit",
    "cf-typegen": "wrangler types --include-runtime=false",
    "deploy": "CLOUDFLARE_ENV=production pnpm build && wrangler deploy",
